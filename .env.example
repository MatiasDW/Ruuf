# Plantilla de entorno. Copiar a .env y generar valores unicos por clon.
# .env esta ignorado por Git y nunca debe commitearse: este archivo solo lleva
# marcadores vacios. Un valor real pegado aqui bloquea el commit (SEC-102).
#
# Generar valores nuevos, por ejemplo:
#   POSTGRES_PASSWORD / REDIS_PASSWORD -> openssl rand -hex 24
#   DJANGO_SECRET_KEY                  -> openssl rand -hex 48
POSTGRES_PASSWORD=
REDIS_PASSWORD=
DJANGO_SECRET_KEY=

# Stitch es solo herramienta de diseno: la key no llega al browser ni al runtime.
# La clave compartida durante el prototipo sigue pendiente de rotacion en SEC-103,
# obligatoria antes de piloto, staging o cualquier despliegue externo.
STITCH_API_KEY=
STITCH_MCP_URL=https://stitch.googleapis.com/mcp

# Puertos de host opcionales, utiles con varios workspaces Conductor a la vez.
BACKEND_PORT=5050
FRONTEND_PORT=5173
